# The seller's credentials, from the .env that `ekl agent init` wrote in this folder. Copy to seller.env.
# The agent key, which announces agent.json:
EKL_PROVIDER_CREDENTIAL=
# The agent-operation credential, written because the seller takes part (it answers needs):
EKL_AGENT_CREDENTIAL=
EKL_NETWORK_URL=https://eukollab.ai
# Serve the seller through the network's relay, so it needs no public address. Remove it, and give
# `ekl agent init` an --endpoint, to take calls directly at a public https address instead.
EKL_RELAY=1
