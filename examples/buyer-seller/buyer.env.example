# The buyer's credentials, from buyer/.env, which `ekl new agent buyer --does use --take-part` wrote. Copy to buyer.env.
# The agent key, with which the buyer announces its profile (buyer/agent.json) and waits for you to confirm it:
EKL_PROVIDER_CREDENTIAL=
# The agent-operation credential, with which it posts its need and calls the seller:
EKL_AGENT_CREDENTIAL=
EKL_NETWORK_URL=https://eukollab.ai
